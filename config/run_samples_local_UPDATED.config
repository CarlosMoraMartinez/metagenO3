//BASE DIRECTORIES
basedir = "/home/carlos/projects/benchmark4real/"
datadir = "/home/carlos/projects/benchmark4real/extra_data/"
condabase = "/home/carlos/miniforge3/envs"
dockerrepo = "carlosmora91/cmora_images"

//INPUTS
params.raw_fastq =  "$projectDir/test_data/*_{1,2}.filt_cut1e6.fastq.gz" //"$basedir/RawData/*_{1,2}.fq.gz"

//OUTPUTS
workDir = "$basedir/results_pipeline/work/"
env.results_dir = "$basedir/results_pipeline/test2/"

params.workflows.doCleanFastq = false
params.workflows.doKraken2Bracken = false
params.workflows.doCentrifuger = false
params.workflows.doMetaphlan = false
params.workflows.doKMCP = false
params.workflows.doGanon2 = false
params.workflows.doSylph = false
params.workflows.doMetabuli = true
params.workflows.doHumann3 = false
params.workflows.doMultiQC = false

//*****************//
//      RULES      //
//*****************//

// Rule getFastQCIllumina: Quality control of input and trimmed fastq using FastQC
params.getFastQCIllumina.conda = "$condabase/fastqc-env"
params.resources.getFastQCIllumina.cpus= 4
params.resources.getFastQCIllumina.mem = "4 GB"
params.resources.getFastQCIllumina.queue = "global" //"fast"
params.resources.getFastQCIllumina.clusterOptions = "--qos=short" 
params.getFastQCIllumina.do_fastqc_raw = true
params.getFastQCIllumina.do_fastqc_trim = true
params.getFastQCIllumina.do_fastqc_trim_single = true

//Rule doTrimmomatic: trim fastq
params.doTrimmomatic.conda = "$condabase/trimmomatic-env"
params.resources.doTrimmomatic.cpus= 4
params.resources.doTrimmomatic.mem = "4 GB"
params.resources.doTrimmomatic.queue = "global" //"medium"
params.resources.doTrimmomatic.clusterOptions = "--qos=medium --time=1-00:00:00" 
params.doTrimmomatic.illuminaclip = "$datadir/Adapters-for-MGI_simpletrimming.txt:2:30:10"
params.doTrimmomatic.slidingwindow = "20:30"
params.doTrimmomatic.minlen = 75
params.doTrimmomatic.do_trim = true


//Rule alignBowtie2: align
params.alignBowtie2.conda = "$condabase/bowtie2-env"
params.resources.alignBowtie2.cpus= 12
params.resources.alignBowtie2.mem = "8 GB"
params.resources.alignBowtie2.queue = "global" 
params.resources.alignBowtie2.clusterOptions = "--qos=long" 
params.alignBowtie2.index = "$datadir/bowtie-index/GCA_000001405.15_GRCh38_full_analysis_set.fna.bowtie_index"
params.alignBowtie2.options = "--fast-local --phred33 --no-unal "


//Rule samtoolsSort: sort and index bam with human reads
params.samtoolsSort.conda = "$condabase/bowtie2-env"
params.resources.samtoolsSort.cpus= 2
params.resources.samtoolsSort.mem = "4 GB"
params.resources.samtoolsSort.queue = "global" 
params.resources.samtoolsSort.clusterOptions = "--qos=short" 

//Rule removeHumanReads
params.removeHumanReads.conda = "$condabase/seqkit-env"
params.resources.removeHumanReads.cpus= 4
params.resources.removeHumanReads.mem = "4 GB"
params.resources.removeHumanReads.queue = "global" 
params.resources.removeHumanReads.clusterOptions = "--qos=short"
params.removeHumanReads.remove_human_reads = true

//Rule callKraken2
params.callKraken2.conda = "$condabase/kraken2-env"
params.resources.callKraken2.cpus= 12
params.resources.callKraken2.mem = "8 GB"
params.resources.callKraken2.queue = "global"
params.resources.callKraken2.clusterOptions = "--qos=long-mem" //"long-mem" instead of "bigmem"
params.callKraken2.k2database = "$datadir/k2_standard_08gb_20230605"  // k2_standard_08gb_20230605
params.callKraken2.confidence = 0.5
params.resources.callKraken2.do = true

//Rule callKrakenUniq
params.callKrakenUniq.conda = "$condabase/krakenuniq-env"
params.resources.callKrakenUniq.cpus= 12
params.resources.callKrakenUniq.mem = "8 GB"
params.resources.callKrakenUniq.queue = "global"
params.resources.callKrakenUniq.clusterOptions = "--qos=long-mem" //"long-mem" instead of "bigmem"
params.callKrakenUniq.kudatabase = "$datadir/k2_standard_08gb_20230605" //"krakenuniq/kuniq_standard_minus_kdb.20220616"  // k2_plusPF_240524
params.callKrakenUniq.hllprecision = 12
params.resources.callKrakenUniq.do = true

//Rule callBracken
params.callBracken.conda = "$condabase/bracken-env"
params.resources.callBracken.cpus= 4
params.resources.callBracken.mem = "4 GB"
params.resources.callBracken.queue = "global" 
params.resources.callBracken.clusterOptions = "--qos=medium" 
params.callBracken.threshold = 10
params.callBracken.readlen = 75

//Rule braken2mpa
params.braken2mpa.conda = "$condabase/kraken2-env"
params.resources.braken2mpa.cpus= 1
params.resources.braken2mpa.mem = "1 GB"
params.resources.braken2mpa.queue = "global" 
params.resources.braken2mpa.clusterOptions = "--qos=short" 

//Rule combineMpa
params.combineMpa.conda = "$condabase/kraken2-env"
params.resources.combineMpa.cpus= 1
params.resources.combineMpa.mem = "1 GB"
params.resources.combineMpa.queue = "global" 
params.resources.combineMpa.clusterOptions = "--qos=short"  


//Rule callKronaFromKraken2
params.callKronaFromKraken2.conda = "$condabase/krona-env"
params.resources.callKronaFromKraken2.cpus= 2
params.resources.callKronaFromKraken2.mem = "4 GB"
params.resources.callKronaFromKraken2.queue = "global" //"fast"
params.resources.callKronaFromKraken2.clusterOptions = "--qos=short"
params.resources.callKronaFromKraken2.do_krona = false

//Rule CentrifugerDownload
params.CentrifugerDownload.do = false
params.CentrifugerDownload.conda = "$condabase/centrifuger-env"
params.resources.CentrifugerDownload.cpus= 2
params.resources.CentrifugerDownload.mem = "4 GB"
params.resources.CentrifugerDownload.queue = "global" //"fast"
params.resources.CentrifugerDownload.clusterOptions = "--qos=short"
params.CentrifugerDownload.argument_list = "refseq:-d \"fungi\":library1;refseq:-d \"archaea\":library2;"


//Rule CentrifugerMakeFileList
params.CentrifugerMakeFileList.merge_dbs = false
params.CentrifugerMakeFileList.merges_dbs_name = "cfgrArFun"
params.CentrifugerMakeFileList.conda = "$condabase/centrifuger-env"
params.resources.CentrifugerMakeFileList.cpus= 1
params.resources.CentrifugerMakeFileList.mem = "1 GB"
params.resources.CentrifugerMakeFileList.queue = "global" //"fast"
params.resources.CentrifugerMakeFileList.clusterOptions = "--qos=short"

// Rule CentrifugerBuildDB
params.CentrifugerBuildDB.do = true
params.CentrifugerBuildDB.conda = "$condabase/centrifuger-env"
params.resources.CentrifugerBuildDB.cpus= 4
params.resources.CentrifugerBuildDB.mem = "14 GB"
params.resources.CentrifugerBuildDB.queue = "global" //"fast"
params.resources.CentrifugerBuildDB.clusterOptions = "--qos=short"
params.CentrifugerBuildDB.options = ""
// These 4 are only used if params.CentrifugerDownload.do = false:
params.CentrifugerBuildDB.index_name = "CFGRFungi2"
params.CentrifugerBuildDB.filelist = "/home/carmoma/projects/TFM_MiguelAngelEsteve/test_software/test_buildb/library2_file_list.txt"
params.CentrifugerBuildDB.seqid2taxid = "/home/carmoma/projects/TFM_MiguelAngelEsteve/test_software/test_buildb/library2_seqid2taxid2.map"
params.CentrifugerBuildDB.taxonomy = "/home/carmoma/projects/TFM_MiguelAngelEsteve/test_software/taxonomy/"

// Rule CentrifugerCall
params.CentrifugerCall.do = true
params.CentrifugerCall.conda = "$condabase/centrifuger-env"
params.resources.CentrifugerCall.cpus= 4
params.resources.CentrifugerCall.mem = "14 GB"
params.resources.CentrifugerCall.queue = "global" //"fast"
params.resources.CentrifugerCall.clusterOptions = "--qos=short"
params.CentrifugerCall.options = "-k 1 "  //k=1 is default
// These 2 are only used if params.CentrifugerBuildDB.do = false
params.CentrifugerCall.index_path = "/home/carmoma/projects/TFM_MiguelAngelEsteve/test_software/fungi_index/" 
params.CentrifugerCall.index_name = "refseq_abv"

//Rule multiQC
params.multiQC.conda = "$condabase/multiqc-env"
params.resources.multiQC.cpus= 12
params.resources.multiQC.mem = "6 GB"
params.resources.multiQC.queue = "global" 
params.resources.multiQC.clusterOptions = "--qos=short" 
params.multiQC.configyaml = "$basedir/metagen1/config/multiqc_1_vero.yaml"

//Rule concatFastq
params.concatFastq.conda = "$condabase/seqkit-env" //needs pigz
params.resources.concatFastq.cpus= 4
params.resources.concatFastq.mem = "4 GB"
params.resources.concatFastq.queue = "global"
params.resources.concatFastq.clusterOptions = "--qos=medium" 

//Rule Metaphlan
params.doMetaphlan.conda = "$condabase/humann3-env"
params.resources.doMetaphlan.cpus = 12
params.resources.doMetaphlan.mem = "32 GB"
params.resources.doMetaphlan.queue = "global" 
params.resources.doMetaphlan.clusterOptions = "--qos=short" 
params.doMetaphlan.bowtie2db = "$datadir/metaphlan/"
params.doMetaphlan.metaphlan_index = "mpa_vJun23_CHOCOPhlAnSGB_202403_VSG"

//Rule mergeMetaphlan
params.mergeMetaphlan.conda = "$condabase/metaphlan-env"
params.resources.mergeMetaphlan.cpus = 4
params.resources.mergeMetaphlan.mem = "4 GB"
params.resources.mergeMetaphlan.queue = "global" 
params.resources.mergeMetaphlan.clusterOptions = "--qos=short" 

// Rule KMCPComputeKmers
params.KMCPComputeKmers.do = true //do KMCP database or not
params.KMCPComputeKmers.conda = "$condabase/kmcp-env"
params.resources.KMCPComputeKmers.cpus = 8
params.resources.KMCPComputeKmers.mem = "12 GB"
params.resources.KMCPComputeKmers.queue = "global" 
params.resources.KMCPComputeKmers.clusterOptions = "--qos=short" 
params.KMCPComputeKmers.db_name = "eupath28test"
params.KMCPComputeKmers.fasta_dir = "/home/carmoma/projects/TFM_MiguelAngelEsteve/test_software/eupathdb/library/"
params.KMCPComputeKmers.seqname_regex = ""
params.KMCPComputeKmers.seqname_filter = 'plasmid'
params.KMCPComputeKmers.kmer = 21
params.KMCPComputeKmers.split_number = 10
params.KMCPComputeKmers.split_overlap = 150
params.KMCPComputeKmers.extra_args = ""

// Rule KMCPIndex
params.KMCPIndex.conda = "$condabase/kmcp-env"
params.resources.KMCPIndex.cpus = 8
params.resources.KMCPIndex.mem = "12 GB"
params.resources.KMCPIndex.queue = "global" 
params.resources.KMCPIndex.clusterOptions = "--qos=short"  
params.KMCPIndex.numhash = 1
params.KMCPIndex.fprate = 0.3
params.KMCPIndex.extra_args = ""

// Rule KMCPSearch
params.KMCPSearch.conda = "$condabase/kmcp-env"
params.resources.KMCPSearch.cpus = 8
params.resources.KMCPSearch.mem = "12 GB"
params.resources.KMCPSearch.queue = "global" 
params.resources.KMCPSearch.clusterOptions = "--qos=short" 
params.KMCPSearch.db_name = "eupathdb28"  // only used if not created
params.KMCPSearch.database = "/home/carmoma/projects/TFM_MiguelAngelEsteve/test_software/KMCP/eupathdb28.kmcp" 
params.KMCPSearch.extra_args = ""

// Rule KMCPSearch
params.KMCPProfile.conda = "$condabase/kmcp-env"
params.resources.KMCPProfile.cpus = 8
params.resources.KMCPProfile.mem = "12 GB"
params.resources.KMCPProfile.queue = "global" 
params.resources.KMCPProfile.clusterOptions = "--qos=short" 
params.KMCPProfile.taxidmap = "/home/carmoma/projects/TFM_MiguelAngelEsteve/test_software/eupathdb/intentomapid.map" 
params.KMCPProfile.taxonomy = "/home/carmoma/projects/TFM_MiguelAngelEsteve/test_software/KMCP/taxonomy/" 
params.KMCPProfile.mode = 1  // only used if not created
params.KMCPProfile.database = "" 
params.KMCPProfile.extra_args = ""

// Rule GanonBuildDefault
params.GanonBuildDefault.conda = "$condabase/ganon2-env"
params.resources.GanonBuildDefault.cpus = 6
params.resources.GanonBuildDefault.mem = "12 GB"
params.resources.GanonBuildDefault.queue = "global" 
params.resources.GanonBuildDefault.clusterOptions = "--qos=short" 
params.GanonBuildDefault.db_name = 'FunProTest'
params.GanonBuildDefault.genomes = 'fungi protozoa'
params.GanonBuildDefault.extra_args = "-c"
params.GanonBuildDefault.do = true

// Rule GanonBuildCustom
params.GanonBuildCustom.conda = "$condabase/ganon2-env"
params.resources.GanonBuildCustom.cpus = 8
params.resources.GanonBuildCustom.mem = "12 GB"
params.resources.GanonBuildCustom.queue = "global" 
params.resources.GanonBuildCustom.clusterOptions = "--qos=short" 
params.GanonBuildCustom.db_name = 'Eupathtest1'
//params.GanonBuildCustom.fasta_dir = '/home/carmoma/projects/TFM_MiguelAngelEsteve/test_software/eupathdb/library/'
params.GanonBuildCustom.input_file = '/home/carmoma/projects/TFM_MiguelAngelEsteve/test_software/eupathdb/intentomapid_ganon2.map'
params.GanonBuildCustom.fasta_extension = 'fna'
taxonomy_dir = "/home/carmoma/projects/TFM_MiguelAngelEsteve/test_software/KMCP/taxonomy/"
tax_nodes = "$taxonomy_dir/nodes.dmp"
tax_names = "$taxonomy_dir/names.dmp"
params.GanonBuildCustom.taxonomy = "--taxonomy-files $tax_nodes $tax_names"
params.GanonBuildCustom.extra_args = '' //'--taxonomy skip --skip-genome-size'
params.GanonBuildCustom.do = false //overriden if default true

// Rule GanonClassify
params.GanonClassify.conda = "$condabase/ganon2-env"
params.resources.GanonClassify.cpus = 8
params.resources.GanonClassify.mem = "12 GB"
params.resources.GanonClassify.queue = "global" 
params.resources.GanonClassify.clusterOptions = "--qos=short" 
params.GanonClassify.rel_cutoff = 0.75
params.GanonClassify.rel_filter = 0.1
params.GanonClassify.min_count = 0.00005
params.GanonClassify.multiple_matches = 'em'
params.GanonClassify.report_type = 'abundance'
params.GanonClassify.extra_args = ''
params.GanonClassify.db_name = "" //Only if build index set to false
params.GanonClassify.database = ""

// Rule callSylphProfileSingle
params.callSylphProfile.sylphdb = "$datadir/gtdb-r220-c1000-dbv1.syldb"
params.callSylphProfile.separate_samples  =  true

params.callSylphProfileSingle.conda = "$condabase/sylph-env"
params.resources.callSylphProfileSingle.cpus = 2
params.resources.callSylphProfileSingle.mem = "12 GB"
params.resources.callSylphProfileSingle.queue = "global"
params.resources.callSylphProfileSingle.clusterOptions = "--qos=short" 

// Rule callSylphProfileMany
params.callSylphProfileMany.conda = "$condabase/sylph-env"
params.resources.callSylphProfileMany.cpus = 2
params.resources.callSylphProfileMany.mem = "12 GB"
params.resources.callSylphProfileMany.queue = "global"
params.resources.callSylphProfileMany.clusterOptions = "--qos=short" 


// Rule callSylphTaxprof
params.callSylphTaxprof.conda = "$condabase/sylphtax-env"
params.resources.callSylphTaxprof.cpus = 2
params.resources.callSylphTaxprof.mem = "8 GB"
params.resources.callSylphTaxprof.queue = "global"
params.resources.callSylphTaxprof.clusterOptions = "--qos=short" 
params.resources.callSylphTaxprof.taxonomy_db = "GTDB_r220" // Taxonomy files location is stored in a json file automatically when downloaded

// Rule mergeSylph
params.mergeSylph.conda = "$condabase/sylphtax-env" //just needs python with pandas
params.resources.mergeSylph.cpus = 1
params.resources.mergeSylph.mem = "8 GB"
params.resources.mergeSylph.queue = "global"
params.resources.mergeSylph.clusterOptions = "--qos=short" 

// Rule callMetabuli
params.callMetabuli.conda = "$condabase/metabuli-env" //just needs python with pandas
params.resources.callMetabuli.cpus = 4
params.resources.callMetabuli.mem = "6 GB"
params.resources.callMetabuli.queue = "global"
params.resources.callMetabuli.clusterOptions = "--qos=short" 
params.resources.callMetabuli.db = "$datadir/OUT_DIR/refseq_virus" 
params.resources.callMetabuli.taxonomy_path = "$datadir/OUT_DIR/refseq_virus/taxonomy" 
params.resources.callMetabuli.min_score = 0.15
params.resources.callMetabuli.min_sp_score = 0.5
params.resources.callMetabuli.min_cons_cnt = 4
params.resources.callMetabuli.min_cons_cnt_euk = 9
params.resources.callMetabuli.accession_level = 0
params.resources.callMetabuli.print_lineage = 1

// Rule callMetabuliRefine
params.callMetabuliRefine.conda = "$condabase/metabuli-env" //just needs python with pandas
params.resources.callMetabuliRefine.cpus = 4
params.resources.callMetabuliRefine.mem = "6 GB"
params.resources.callMetabuliRefine.queue = "global"
params.resources.callMetabuliRefine.clusterOptions = "--qos=short" 
params.resources.callMetabuliRefine.db = "$datadir/OUT_DIR/refseq_virus" 
params.resources.callMetabuliRefine.min_score = 0.55
params.resources.callMetabuliRefine.remove_unclassified = 0
params.resources.callMetabuliRefine.do = false

//Rule doHumann3
params.doHumann3.conda = "$condabase/metagenomics"
params.resources.doHumann3.cpus= 20
params.resources.doHumann3.mem = "100 GB"
params.resources.doHumann3.queue = "global" 
params.resources.doHumann3.clusterOptions = "--qos=long" 
params.doHumann3.bowtie2db = "/home/ysanz/.local/lib/python3.9/site-packages/metaphlan/metaphlan_databases/"
params.doHumann3.metaphlan_index = "mpa_vOct22_CHOCOPhlAnSGB_202212"

//Rule mergeHumann3
params.resources.mergeHumann3.cpus = 4
params.resources.mergeHumann3.mem = "12 GB"
params.resources.mergeHumann3.queue = "global"
params.resources.doHumann3.clusterOptions = "--qos=long" 

//Rule translateHumann3
params.resources.translateHumann3.cpus = 4
params.resources.translateHumann3.mem = "12 GB"
params.resources.translateHumann3.queue = "global"
params.resources.doHumann3.clusterOptions = "--qos=long" 
params.translateHumann3.cazy_db = "$datadir/humann_dbs/utility_mapping/utility_mapping/map_cazy_uniref90.txt.gz"

//*****************//
// GENERAL OPTIONS //
//*****************//

cleanup = false
conda.enabled = true
params.resources.default.cpus = 4
params.resources.default.mem = "2 GB"
params.resources.array_size = 100

params.mapping_tool = "bowtie2"

profiles {
    conda {
      process.conda = "$condabase/fastqc-env"
    }
}
docker {
    enabled = false
    sudo = true
}

dag {
    enabled = true
    overwrite = true
    file = "$env.results_dir/pipeline_dag.html"
}
report {
    enabled = true
    overwrite = true
    file = "$env.results_dir/report.html"
}
timeline {
    enabled = true
    overwrite = true
    file = "$env.results_dir/report.html"
}

//process {
//  executor = "slurm"
//  queueSize = 100
//  submitRateLimit = "10sec"
//  queue = "long"
//}

// DOCKER OPTIONS
process {
    withName:GanonBuildDefault{
        container = "$dockerrepo:ganon2"
        containerOptions = "--mount type=bind,source=$datadir,target=$datadir"
    }
    withName:GanonBuildCustom{
        container = "$dockerrepo:ganon2"
        containerOptions = "--mount type=bind,source=$datadir,target=$datadir"
    }
    withName:GanonClassify{
        container = "$dockerrepo:ganon2"
        containerOptions = "--mount type=bind,source=$datadir,target=$datadir"
    }
}

